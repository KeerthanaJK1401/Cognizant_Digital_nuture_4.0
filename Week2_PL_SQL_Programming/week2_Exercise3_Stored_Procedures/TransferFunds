CREATE OR REPLACE PROCEDURE UpdateEmployeeBonus (
    dept_name IN EMPLOYEES.DEPARTMENT%TYPE,
    bonus_percent IN NUMBER
) IS
    CURSOR emp_cursor IS
        SELECT EMPLOYEEID, NAME, SALARY
        FROM EMPLOYEES
        WHERE DEPARTMENT = dept_name;

    v_id EMPLOYEES.EMPLOYEEID%TYPE;
    v_name EMPLOYEES.NAME%TYPE;
    v_old_salary EMPLOYEES.SALARY%TYPE;
    v_bonus NUMBER;
BEGIN
    FOR emp IN emp_cursor LOOP
        v_id := emp.EMPLOYEEID;
        v_name := emp.NAME;
        v_old_salary := emp.SALARY;
        v_bonus := v_old_salary * bonus_percent / 100;

        UPDATE EMPLOYEES
        SET SALARY = SALARY + v_bonus
        WHERE EMPLOYEEID = v_id;

        DBMS_OUTPUT.PUT_LINE('Employee ' || v_name || ' (ID: ' || v_id || ') received a bonus of ₹' || TO_CHAR(v_bonus, '99990.00'));
    END LOOP;

    COMMIT;
END;
/
SET SERVEROUTPUT ON;

BEGIN
    UpdateEmployeeBonus('IT', 10);
END;
/
